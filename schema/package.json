{
  "name": "@simpleguitar/bridge-schema",
  "private": true,
  "version": "0.0.0",
  "description": "Bridge protocol JSON Schema + generated TypeScript types for Simple Guitar (see README.md).",
  "type": "module",
  "scripts": {
    "gen": "node gen-types.mjs",
    "typecheck": "tsc --noEmit --strict -p tsconfig.json",
    "validate": "node validate-schema.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.6.3"
  }
}
